+//! Local companion contract. CC Switch owns credentials and native configuration;
+//! the router receives access-only leases and never a refresh token.
+use axum::{
+    extract::{DefaultBodyLimit, Request, State},
+    http::{header, StatusCode},
+    middleware::{self, Next},
+    response::{IntoResponse, Response},
+    routing::{get, post},
+    Json, Router,
+};
+use base64::{engine::general_purpose::URL_SAFE_NO_PAD, Engine};
+use serde::Deserialize;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{path::PathBuf, sync::Arc};
+use subtle::ConstantTimeEq;
+use tokio::sync::Mutex;
+use crate::{AppState, AppType, Provider, ProviderService};
+
+const PROVIDER_ID: &str = "codex-plan-router-linked";
+const SCHEMA: u32 = 1;
+
+#[derive(Clone)]
+struct Bridge {
+    app: AppState,
+    token: String,
+    host: String,
+    mutation: Arc<Mutex<()>>,
+}
+
+type ResultJson = Result<Json<Value>, (StatusCode, Json<Value>)>;
+fn failure(status: StatusCode, code: &str) -> (StatusCode, Json<Value>) {
+    (status, Json(json!({"error": code})))
+}
+fn internal<E>(_: E) -> (StatusCode, Json<Value>) {
+    failure(StatusCode::CONFLICT, "cc_operation_failed")
+}
+fn directory() -> PathBuf {
+    crate::config::get_app_config_dir().join("plan-router-bridge")
+}
+
+fn valid_endpoint(value: &str) -> bool {
+    url::Url::parse(value).is_ok_and(|url| {
+        url.scheme() == "http" && url.host_str() == Some("127.0.0.1")
+            && url.port().is_some_and(|p| p > 1024)
+            && url.path() == "/v1" && url.query().is_none() && url.fragment().is_none()
+            && url.username().is_empty() && url.password().is_none()
+    })
+}
+fn valid_bearer(value: &str) -> bool {
+    (40..=128).contains(&value.len())
+        && value.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'-' || c == b'_')
+}
+
+/// Only our explicit loopback card preserves the managed native login. Ordinary
+/// third-party cards retain upstream CC Switch's existing login policy.
+pub(crate) fn owns_provider(provider: &Provider) -> bool {
+    if !cfg!(feature = "plan-router-bridge") || provider.id != PROVIDER_ID {
+        return false;
+    }
+    let config = provider.settings_config.get("config").and_then(Value::as_str).unwrap_or("");
+    crate::codex_config::extract_codex_base_url(config).is_some_and(|url| valid_endpoint(&url))
+        && crate::codex_config::extract_codex_experimental_bearer_token(config)
+            .is_some_and(|key| valid_bearer(&key))
+}
+
+fn official_key(provider: &Provider) -> Option<String> {
+    if provider.id == PROVIDER_ID { return None; }
+    let config = provider.settings_config.get("config").and_then(Value::as_str).unwrap_or("");
+    // Explicit official API endpoints only: no recursive loopback providers,
+    // third-party API hosts, environment references, or OAuth card snapshots.
+    let base = crate::codex_config::extract_codex_base_url(config)?;
+    if base.trim_end_matches('/') != "https://api.openai.com/v1" { return None; }
+    crate::codex_config::extract_codex_api_key(provider.settings_config.get("auth"), Some(config))
+        .filter(|key| key.starts_with("sk-") && key.len() >= 30)
+}
+
+async fn authorize(State(state): State<Bridge>, request: Request, next: Next) -> Response {
+    let headers = request.headers();
+    let bearer = headers.get(header::AUTHORIZATION).and_then(|x| x.to_str().ok()).unwrap_or("");
+    let expected = format!("Bearer {}", state.token);
+    if headers.contains_key(header::ORIGIN)
+        || headers.get(header::HOST).and_then(|x| x.to_str().ok()) != Some(state.host.as_str()) {
+        return failure(StatusCode::FORBIDDEN, "local_client_required").into_response();
+    }
+    if !bool::from(bearer.as_bytes().ct_eq(expected.as_bytes())) {
+        return failure(StatusCode::UNAUTHORIZED, "bridge_auth_required").into_response();
+    }
+    let mut response = next.run(request).await;
+    response.headers_mut().insert(header::CACHE_CONTROL, "no-store".parse().unwrap());
+    response
+}
+
+async fn catalog(State(state): State<Bridge>) -> ResultJson {
+    let accounts = state.app.codex_oauth_manager.list_accounts().await;
+    let providers = state.app.db.get_all_providers("codex").map_err(internal)?;
+    let mut keys: Vec<_> = providers.values().filter_map(|p| official_key(p).map(|key| {
+        json!({"id": p.id, "label": p.name, "revision": format!("{:x}", Sha256::digest(key)),
+               "order": p.sort_index.unwrap_or(usize::MAX)})
+    })).collect();
+    keys.sort_by_key(|x| (x["order"].as_u64().unwrap_or(u64::MAX), x["id"].as_str().unwrap_or("").to_owned()));
+    let mode = crate::mode::controller::app_mode_view(&state.app, &AppType::Codex).map_err(internal)?;
+    Ok(Json(json!({"schema": SCHEMA, "version": env!("CARGO_PKG_VERSION"),
+        "features": ["native-model-catalog"],
+        "codex_home": crate::codex_config::get_codex_config_dir(),
+        "accounts": accounts.into_iter().map(|a| json!({"id": a.id, "label": a.login,
+            "reauth_required": a.reauth_required, "revision": a.authenticated_at})).collect::<Vec<_>>(),
+        "keys": keys, "route": mode, "linked": mode.mode == "direct" && mode.direct_provider_id.as_deref() == Some(PROVIDER_ID)
+    })))
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct AccountRequest { id: String }
+
+async fn plan_lease(State(state): State<Bridge>, Json(input): Json<AccountRequest>) -> ResultJson {
+    if input.id.len() > 256 { return Err(failure(StatusCode::BAD_REQUEST, "invalid_account")); }
+    let bundle = state.app.codex_oauth_manager.get_valid_token_bundle_for_account(&input.id)
+        .await.map_err(|_| failure(StatusCode::CONFLICT, "account_unavailable"))?;
+    let claims = bundle.access_token.split('.').nth(1)
+        .and_then(|x| URL_SAFE_NO_PAD.decode(x.trim_end_matches('=')).ok())
+        .and_then(|x| serde_json::from_slice::<Value>(&x).ok());
+    let expires = claims.as_ref().and_then(|v| v["exp"].as_i64())
+        .filter(|t| *t > chrono::Utc::now().timestamp() + 15)
+        .ok_or_else(|| failure(StatusCode::CONFLICT, "invalid_access_lease"))?;
+    // Deliberately enumerate fields. Never serialize ManagedTokenBundle.
+    Ok(Json(json!({"id": input.id, "account_id": bundle.chatgpt_account_id,
+        "access_token": bundle.access_token, "id_token": bundle.id_token,
+        "expires_at": expires, "last_refresh": bundle.last_refresh})))
+}
+
+async fn key_lease(State(state): State<Bridge>, Json(input): Json<AccountRequest>) -> ResultJson {
+    let provider = state.app.db.get_provider_by_id(&input.id, "codex").map_err(internal)?
+        .ok_or_else(|| failure(StatusCode::NOT_FOUND, "key_removed"))?;
+    let key = official_key(&provider).ok_or_else(|| failure(StatusCode::NOT_FOUND, "key_removed"))?;
+    Ok(Json(json!({"id": input.id, "key": key, "base_url": "https://api.openai.com/v1"})))
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ActivateRequest { base_url: String, bearer: String, model: String, codex_home: PathBuf }
+
+async fn activate(State(state): State<Bridge>, Json(input): Json<ActivateRequest>) -> ResultJson {
+    if !valid_endpoint(&input.base_url) || !valid_bearer(&input.bearer)
+        || input.model.is_empty() || input.model.len() > 128
+        || !input.model.bytes().all(|c| c.is_ascii_alphanumeric() || b"-._/".contains(&c)) {
+        return Err(failure(StatusCode::BAD_REQUEST, "invalid_route"));
+    }
+    if input.codex_home.canonicalize().ok() != crate::codex_config::get_codex_config_dir().canonicalize().ok()
+        || !input.codex_home.is_dir() {
+        return Err(failure(StatusCode::CONFLICT, "codex_home_mismatch"));
+    }
+    let _guard = state.mutation.lock().await;
+    tokio::task::spawn_blocking(move || {
+        let mut config = format!("model_provider = \"custom\"\nmodel = {}\n",
+            serde_json::to_string(&input.model).unwrap());
+        // The router owns this derived native catalog, CC Switch owns the config
+        // pointer. Keep all user-selectable models, rather than a single card model.
+        let catalog_path = crate::codex_config::get_codex_config_dir().join("codex-plan-router-models.json");
+        if catalog_path.is_file() {
+            let bytes = std::fs::read(&catalog_path).map_err(internal)?;
+            if bytes.len() > 8 * 1024 * 1024 {
+                return Err(failure(StatusCode::BAD_REQUEST, "invalid_model_catalog"));
+            }
+            let catalog: Value = serde_json::from_slice(&bytes).map_err(internal)?;
+            if !catalog["models"].as_array().is_some_and(|models| !models.is_empty()) {
+                return Err(failure(StatusCode::BAD_REQUEST, "invalid_model_catalog"));
+            }
+            config.push_str(&format!("model_catalog_json = {}\n", serde_json::to_string(&catalog_path).unwrap()));
+        }
+        config.push_str(&format!("[model_providers.custom]\nname = \"Plan Router\"\nbase_url = {}\nwire_api = \"responses\"\nexperimental_bearer_token = {}\nsupports_websockets = false\n",
+            serde_json::to_string(&input.base_url).unwrap(), serde_json::to_string(&input.bearer).unwrap()));
+        let provider = Provider::with_id(PROVIDER_ID.into(), "Plan Router · CC 联动".into(),
+            json!({"config": config, "auth": {}}), None);
+        ProviderService::activate_plan_router(&state.app, provider, &directory().join("route-before.json"))
+            .map_err(route_failure)?;
+        Ok(Json(json!({"activated": true, "restart_required": true})))
+    }).await.map_err(internal)?
+}
+
+async fn restore(State(state): State<Bridge>) -> ResultJson {
+    let _guard = state.mutation.lock().await;
+    tokio::task::spawn_blocking(move || {
+        let backup: Value = crate::config::read_json_file(&directory().join("route-before.json")).map_err(internal)?;
+        let id = backup["provider_id"].as_str().filter(|id| *id != PROVIDER_ID)
+            .ok_or_else(|| failure(StatusCode::CONFLICT, "previous_provider_missing"))?;
+        ProviderService::restore_plan_router(&state.app, PROVIDER_ID, id).map_err(route_failure)?;
+        Ok(Json(json!({"restored": true})))
+    }).await.map_err(internal)?
+}
+
+fn route_failure(error: crate::AppError) -> (StatusCode, Json<Value>) {
+    match error {
+        crate::AppError::Message(code) if matches!(code.as_str(), "cc_direct_mode_required" | "route_changed_elsewhere" | "previous_provider_missing") =>
+            failure(StatusCode::CONFLICT, &code),
+        _ => failure(StatusCode::CONFLICT, "cc_operation_failed"),
+    }
+}
+
+fn router(state: Bridge) -> Router {
+    Router::new().route("/v1/catalog", get(catalog))
+        .route("/v1/lease/plan", post(plan_lease)).route("/v1/lease/key", post(key_lease))
+        .route("/v1/route/activate", post(activate)).route("/v1/route/restore", post(restore))
+        .layer(DefaultBodyLimit::max(16384))
+        .layer(middleware::from_fn_with_state(state.clone(), authorize)).with_state(state)
+}
+
+pub(crate) async fn start(app: AppState) -> Result<(), String> {
+    // Preserve the user's existing startup preference while repointing its
+    // existing CC Switch login item to this companion bundle.
+    if crate::settings::get_settings().launch_on_startup {
+        let _ = crate::auto_launch::enable_auto_launch();
+    }
+    let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0)).await.map_err(|_| "bridge_bind_failed")?;
+    let host = listener.local_addr().map_err(|_| "bridge_bind_failed")?.to_string();
+    let token = format!("{}{}", uuid::Uuid::new_v4().simple(), uuid::Uuid::new_v4().simple());
+    std::fs::create_dir_all(directory()).map_err(|_| "bridge_discovery_failed")?;
+    #[cfg(unix)] {
+        use std::os::unix::fs::PermissionsExt;
+        std::fs::set_permissions(directory(), std::fs::Permissions::from_mode(0o700)).map_err(|_| "bridge_discovery_failed")?;
+    }
+    let discovery = directory().join("connection.json");
+    crate::config::write_json_file_private(&discovery, &json!({"schema": SCHEMA, "host": "127.0.0.1",
